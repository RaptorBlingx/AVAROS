# ─────────────────────────────────────────────────────────────────────────────
# AVAROS Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and customize as needed.
# Platform credentials (RENERYO URL, API keys) are entered via the Web UI
# wizard — not here.
#
# Full reference: docs/ENV-REFERENCE.md
# ─────────────────────────────────────────────────────────────────────────────

# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# PostgreSQL credentials used by docker-compose.avaros.yml.
POSTGRES_USER=avaros
# Set a strong password in production.
POSTGRES_PASSWORD=

# Connection URL for the PostgreSQL database.
# Default works with the Docker Compose setup (avaros_db service).
# Replace <password> with the value of POSTGRES_PASSWORD.
AVAROS_DATABASE_URL=postgresql://avaros:<password>@avaros_db:5432/avaros

# ============================================================================
# Platform Adapter
# ============================================================================

# Platform adapter is configured via the Web UI wizard (not this env var).
# All platforms use "custom_rest" (GenericRestAdapter).
# Leave empty for zero-config first run (DEC-005: UnconfiguredAdapter).
ADAPTER_TYPE=

# ============================================================================
# PREVENTION Analytics
# ============================================================================

# Base URL for the PREVENTION GraphQL endpoint.
# Leave empty when no PREVENTION runtime is available. When PREVENTION is
# deployed on the same Docker network, use: http://prevention:8081
PREVENTION_URL=

# PREVENTION auth mode: none, bearer, or keycloak_client_credentials.
PREVENTION_AUTH_MODE=none

# Optional pre-issued bearer token for authenticated PREVENTION deployments.
PREVENTION_AUTH_TOKEN=

# Optional Keycloak/OIDC client-credentials auth for PREVENTION deployments
# that run behind Keycloak. These values are normally provided by the
# PREVENTION/platform administrator.
PREVENTION_KEYCLOAK_TOKEN_URL=
PREVENTION_KEYCLOAK_CLIENT_ID=
PREVENTION_KEYCLOAK_CLIENT_SECRET=
PREVENTION_KEYCLOAK_SCOPE=

# Mark PREVENTION input data as stale when the export manifest exceeds this age.
PREVENTION_DATA_MAX_AGE_MINUTES=1440

# Continuously export the active AVAROS platform profile into PREVENTION input
# files. Disable when PREVENTION is not used or when exports are scheduled
# externally.
PREVENTION_EXPORT_ENABLED=true
PREVENTION_EXPORT_INTERVAL_SECONDS=900
PREVENTION_EXPORT_DAYS=30
PREVENTION_EXPORT_PROFILE=

# PREVENTION development stack settings.
PREVENTION_PORT=8082
PREVENTION_MONGO_USER=prevention
PREVENTION_MONGO_PASS=prevention

# External PREVENTION repo build context for docker/docker-compose.prevention.yml.
# PREVENTION_BUILD_CONTEXT=../../prevention_upd

# ============================================================================
# Web UI Authentication
# ============================================================================

# API key for Web UI and API access. All API requests (except /health) require
# this key in the X-API-Key header.
#
# Generate a secure key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# If not set, a random key is generated on startup and logged.
# AVAROS_WEB_API_KEY=
# Shared sqlite ownership for web-ui/skill containers (defaults shown).
# AVAROS_SHARED_DB_UID=1000
# AVAROS_SHARED_DB_GID=1000

# ============================================================================
# HTTPS / TLS (Nginx Proxy)
# ============================================================================

# External ports mapped to the host
AVAROS_HTTPS_PORT=443
AVAROS_HTTP_PORT=80

# TLS mode: "self-signed" (testing) or "letsencrypt" (production)
AVAROS_TLS_MODE=self-signed

# ============================================================================
# General Settings
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
AVAROS_LOG_LEVEL=INFO

# Timezone
TZ=UTC

# ============================================================================
# HiveMind WebSocket Proxy (DEC-026)
# ============================================================================

# Port for the HiveMind WebSocket endpoint (browser voice clients connect here)
HIVEMIND_PORT=5678

# Master key for HiveMind administrative operations.
# Optional for local runs: if empty, entrypoint auto-generates a value.
# REQUIRED for shared/staging/production deployments — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
HIVEMIND_MASTER_KEY=

# Default client credentials for browser WebSocket connections.
# Optional for local runs: if empty, entrypoint auto-generates values.
# REQUIRED for shared/staging/production deployments — generate each with:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
HIVEMIND_CLIENT_NAME=avaros-web-client
HIVEMIND_CLIENT_KEY=
HIVEMIND_CLIENT_SECRET=
HIVEMIND_CLIENT_CRYPTO_KEY=

# Public WebSocket URL returned by the voice config endpoint to browser clients.
# Use auto behind the AVAROS proxy so browsers receive
# ws(s)://<current-host>/hivemind/ for local, LAN, and public domains.
HIVEMIND_WS_URL=auto

# Internal wake-word backend URL used by the Web UI same-origin proxy.
# Browsers connect to /wakeword/ws/detect on the Web UI origin; FastAPI/Nginx
# forward to this internal service. Keep this default for Docker Compose.
WAKEWORD_BACKEND_URL=http://avaros-wakeword:9999

# Optional allowlist for client message types (comma-separated).
# Keep the default unless you need tighter/looser policies.
HIVEMIND_CLIENT_ALLOWED_TYPES=recognizer_loop:utterance,recognizer_loop:record_begin,recognizer_loop:record_end,recognizer_loop:audio_output_start,recognizer_loop:audio_output_end,recognizer_loop:b64_transcribe,speak:b64_audio,ovos.common_play.SEI.get.response

# Compatibility aliases (legacy names used by older scripts)
# HIVEMIND_ACCESS_KEY=${HIVEMIND_CLIENT_KEY}
# HIVEMIND_PASSWORD=${HIVEMIND_CLIENT_SECRET}

# ============================================================================
# RENERYO Data Generator / Mock Server (Testing / Demo Only)
# ============================================================================

# Port for the data generator mock HTTP server (tools/reneryo-data-generator/)
MOCK_RENERYO_PORT=8090

# Optional server-side file path for bundled mapping_output auto-import.
# If empty, AVAROS uses:
#   tools/reneryo-data-generator/mapping_output.json
# AVAROS_GENERATOR_MAPPING_FILE=

# Optional frontend presets used by Wizard quick actions.
# Override when your RENERYO/mock hosts differ from defaults.
# VITE_RENERYO_PRESET_URL=http://10.33.10.110:30377/
# VITE_MOCK_PRESET_URL=http://reneryo-data-generator-api:8090

# Internal deploy host IP (used in docker-compose.avaros.yml extra_hosts).
# Only needed when connecting to a real RENERYO instance.
RENERYO_DEPLOYS_IP=

# ============================================================================
# Development Settings (Not for Production)
# ============================================================================

# Enable debug mode (more verbose logging)
# AVAROS_DEBUG=false

# Skip authentication (development only — never in production!)
# AVAROS_SKIP_AUTH=false
